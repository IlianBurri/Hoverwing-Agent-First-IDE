{
  "name": "@kestrel/desktop",
  "version": "0.8.1",
  "private": true,
  "productName": "Kestrel",
  "description": "Kestrel desktop app",
  "author": "Ilian",
  "homepage": "https://github.com/IlianBurri/Kestrel-Agen-Harness-IDE",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e:run": "playwright test",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@parcel/watcher": "2.6.0",
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "dockerode": "5.0.1",
    "electron-updater": "6.8.10",
    "node-pty": "1.1.0",
    "openai": "7.43.0",
    "systeminformation": "5.33.16",
    "vscode-jsonrpc": "9.0.3",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@kestrel/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tanstack/react-virtual": "3.14.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/dockerode": "4.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "i18next": "26.5.5",
    "jsdom": "30.1.3",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.8",
    "remark-gfm": "4.0.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vscode-languageserver-protocol": "3.18.4",
    "zustand": "5.0.16"
