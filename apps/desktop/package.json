    "react-dom": "19.3.1",
    "react-i18next": "17.1.1",
    "react-resizable-panels": "4.14.8",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
