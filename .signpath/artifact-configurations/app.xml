<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": the unpacked Windows app
  (release/win-unpacked, uploaded as a GitHub artifact = ZIP).
  Only Hoverwing.exe is signed; Electron's DLLs and the native modules
  (node-pty, ripgrep, @parcel/watcher) are upstream binaries and stay as
  they are. Electron writes the product version with four parts (0.8.1.0).
  Copy this into the SignPath project (Artifact configurations → "app").
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Hoverwing.exe" product-name="Hoverwing" product-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
